# Dataset copies are large and must be tracked by manifests and checksums, not committed.
/model/data/raw/
/model/data/interim/
/model/data/processed/
/model/weights/*
/model/experiments/*
!/model/experiments/README.md
!/model/weights/.gitkeep
!/model/experiments/.gitkeep
/web/backend/logs/*
!/web/backend/logs/README.md
/web/backend/jobs/*
!/web/backend/jobs/README.md
/web/backend/node_modules/

# Generated model and evaluation artifacts stay local; track their metadata separately.
/backups/
~$*.docx
*.tmp.docx

# Local review files and operating-system shortcuts.
/.qa/
/.publish/
*.lnk
/web/backend/e2e_failure.png

# Python and local environment files.
__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
!.env.example
