{
  "version": "scope-0.1.0",
  "requirements_version": "SRS 1.2",
  "definition_status": "FIXED_FOR_PILOT",
  "implementation_status": "OFFLINE_MINIMUM_PIPELINE_VERIFIED_UI_STATIC",
  "operation": {
    "users": "local_single_user",
    "bind": "127.0.0.1",
    "max_input_files": 1,
    "max_nonterminal_jobs": 1,
    "image": "detection_and_frame_summary_only",
    "video": "detection_within_video_tracking_and_evidence_summary",
    "baseline_frame_sampling": "all_decoded_frames"
  },
  "scope": {
    "class_table": "model/configs/classes.json",
    "included": [
      "image/video upload",
      "detection",
      "within-video tracking",
      "evidence-linked finite summary",
      "playback",
      "class/ID filters",
      "persistence",
      "annotated media and CSV/JSON export",
      "independent offline evaluation"
    ],
    "excluded": [
      "live_feed",
      "flight_control",
      "geolocation",
      "physical_speed",
      "face_or_plate_recognition",
      "cross_video_identity",
      "ReID_training",
      "congestion_or_violation_or_accident_recognition",
      "semantic_segmentation",
      "unrestricted_VQA",
      "cloud_multiuser"
    ]
  },
  "states": {
    "nonterminal": [
      "VALIDATING",
      "QUEUED",
      "RUNNING",
      "FINALIZING"
    ],
    "terminal": [
      "SUCCEEDED",
      "FAILED",
      "INTERRUPTED"
    ],
    "transitions": {
      "VALIDATING": [
        "QUEUED",
        "FAILED",
        "INTERRUPTED"
      ],
      "QUEUED": [
        "RUNNING",
        "FAILED",
        "INTERRUPTED"
      ],
      "RUNNING": [
        "FINALIZING",
        "FAILED",
        "INTERRUPTED"
      ],
      "FINALIZING": [
        "SUCCEEDED",
        "FAILED",
        "INTERRUPTED"
      ],
      "SUCCEEDED": [],
      "FAILED": [],
      "INTERRUPTED": []
    }
  },
  "candidate_input_limits": {
    "status": "PENDING_PILOT",
    "image": {
      "formats": [
        "JPEG",
        "PNG"
      ],
      "max_bytes": 15728640,
      "max_width": 4096,
      "max_height": 2160
    },
    "video": {
      "container": "MP4",
      "max_bytes": 209715200,
      "max_seconds": 120,
      "max_width": 1920,
      "max_height": 1080,
      "max_fps": 30
    },
    "codec_policy": "pending_deployed_decoder_and_browser_validation; never silently truncate"
  },
  "model_selection": {
    "family": "YOLO26 detect",
    "priority": "PC accuracy; not real-time",
    "larger_candidates": "verify supported larger weights and memory before selecting; compact baseline retained",
    "selected_weights": null,
    "weights_sha256": null,
    "imgsz": null,
    "confidence_threshold": null,
    "iou_threshold": null,
    "batch": null,
    "epochs": null,
    "seed": null,
    "status": "PENDING_PILOT"
  },
  "tracking": {
    "candidates": [
      "ByteTrack",
      "BoT-SORT"
    ],
    "pilot_baseline": "ByteTrack",
    "selected_tracker": null,
    "parameters": null,
    "identity": "temporary within job; no true unique count",
    "trajectory": "detected bbox centers in source-image pixels; break at missing observations"
  },
  "summary": {
    "engine": "deterministic_templates",
    "coordinates": "source frame; normalized center for region assignment",
    "regions": {
      "status": "definition_fixed_for_pilot",
      "left": "0 <= cx_norm < 1/3",
      "middle": "1/3 <= cx_norm < 2/3",
      "right": "2/3 <= cx_norm <= 1"
    },
    "count": "per-frame valid detections by class, including unassociated detections; not cumulative unique count",
    "video_fields": [
      "first_observed_timestamp",
      "last_observed_timestamp",
      "observed_segments",
      "gaps"
    ],
    "evidence": [
      "job_id",
      "frame_index",
      "timestamp_seconds",
      "detection_id",
      "track_id_or_null",
      "rule_version"
    ],
    "gap_rule": "break on missing decoded frame observation; report absence, not inferred real-world disappearance",
    "region_change_rule": "changing region definitions requires a new config version and affected tests"
  },
  "acceptance": {
    "matrix": "docs/acceptance_matrix.csv",
    "metrics": [
      "per_class_precision",
      "per_class_recall",
      "mAP50",
      "mAP50_95",
      "HOTA",
      "IDF1",
      "MOTA",
      "IDSW",
      "fragmentation",
      "count_MAE",
      "region_count_error",
      "matched_track_time_error",
      "unsupported_summary_rate"
    ],
    "quantitative_thresholds": null,
    "threshold_status": "PENDING_PILOT_FREEZE_BEFORE_FINAL_TEST",
    "block_final_acceptance_if_unset": true,
    "deterministic_checks": "all specified logic cases match expected output",
    "require_all_core_tests_passed": true
  },
  "freeze_gate": {
    "deadline": "before final test and by G3 for pilot parameters",
    "required": [
      "source_mapping_verified",
      "split_overlap_audited",
      "evaluator_adapter_verified",
      "weights_and_thresholds_selected",
      "input_limits_and_codec_verified",
      "numeric_acceptance_thresholds_fixed",
      "review_sample_sizes_fixed"
    ],
    "status": "NOT_EXECUTED"
  },
  "offline_pilot": {
    "guide": "docs/step3_minimal_pipeline.md",
    "config": "model/configs/offline_pilot.json",
    "system_acceptance": "NOT_EXECUTED",
    "training": "NOT_STARTED"
  }
}
